{
    "compilerOptions": {
      "module": "CommonJS",
      "esModuleInterop": true,
      "target": "ES2022",
      "noImplicitAny": false,
      "moduleResolution": "node",
      "sourceMap": true,
      "rootDir": "./",              // Root directory for TypeScript files
      "outDir": "./build",          // Output directory for compiled files
      "strict": true,
      "types": ["node"],
      "experimentalDecorators": true,
      "emitDecoratorMetadata": true
    },
    "include": [
      "./*.ts",                     // Include TypeScript files in the root directory
      "./src/**/*.ts"               // Include TypeScript files in the src folder
    ],
    "exclude": [
      "node_modules",
      "**/*.mock.ts",
      "build"
    ]
}