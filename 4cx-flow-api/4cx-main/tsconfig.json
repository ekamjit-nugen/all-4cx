{
    "compilerOptions": {
        "module":"CommonJS",
        "esModuleInterop": true,
        "target": "ES2022",
        "noImplicitAny": false,
        "moduleResolution":"node",
        "sourceMap": true,
        "rootDir": "./",
        "outDir": "./build",
        "strict": true,
        "types": ["node"],
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true
    },
    "include": [
        "./src/**/*",
        "**/*.spec.ts",
        "**/*.test.ts"
    ],
    "exclude": [
        "node_modules",
        "**/*.mock.ts",
        "build"
    ]
  }